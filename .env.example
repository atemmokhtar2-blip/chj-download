# === Core ===
TELEGRAM_BOT_TOKEN=your_bot_token_here          # required — from @BotFather
OWNER_ID=your_telegram_id                        # owner numeric Telegram ID
ADMIN_IDS=id1,id2                                # comma separated admin IDs

# === Persistent database ===
# Users / downloads / cache live in SQLite. On hosts that rebuild the app
# directory on every deploy (Hugging Face Spaces, Render, Railway), keep the
# DB on the persistent disk so users don't disappear after an update.
# The bot auto-uses /data/bot.db when a /data mount exists. You can override:
# DATABASE_PATH=/data/bot.db
# DATA_DIR=/data

# === Gradio dashboard access control ===
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me_strong_password
# DASHBOARD_AUTH_DISABLED=1                      # local dev only — never in production

# === Limits & behaviour ===
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT=300
RATE_LIMIT_SECONDS=15
RATE_LIMIT_BURST=2
HOURLY_DOWNLOAD_LIMIT=30
DAILY_DOWNLOAD_LIMIT=100
BATCH_MAX_URLS=10
MAX_CONCURRENT_DOWNLOADS=5

# === Audio ===
AUDIO_BITRATE=192                               # normal MP3 button
AUDIO_BITRATE_HIGH=320                          # "MP3 320kbps" button

# === Large video splitting ===
AUTO_SPLIT_LARGE_VIDEOS=1                       # 1=split, 0=refuse oversized videos

# === Caching / vault ===
CACHE_TTL_SECONDS=86400
CACHE_MAX_SIZE=1000
STORAGE_CHANNEL_ID=                             # durable Telegram Media Vault channel

# === Scale ===
REDIS_URL=                                      # redis://[:password]@host:6379/0

# === Engine hardening (optional) ===
YTDLP_CLIENT=android                            # youtube player_client preference
YTDLP_COOKIES_FILE=cookies.txt                  # Netscape cookies path (Instagram/Facebook/YouTube)
YTDLP_COOKIES_FROM_BROWSER=                     # e.g. chrome / firefox / edge
DOWNLOAD_PROXY=                                 # http/socks proxy for blocked regions
YOUTUBE_PO_TOKEN=                               # YouTube PO token (advanced hardening)
YOUTUBE_VISITOR_DATA=                           # YouTube visitor_data (advanced hardening)

